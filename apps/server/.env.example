# LiveKit (required)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Room
ROOM_NAME=project-mayhem-room
AGENT_NAME=project-mayhem-agent

# TTS: gnani (Timbre) or edge (free fallback)
TTS_BACKEND=gnani
GNANI_API_KEY=
GNANI_VOICE=Kaveri
GNANI_LANGUAGE=en-IN

# Replies: auto | en | hi
REPLY_LANGUAGE=auto

# Video still-face track on CPU
ENABLE_VIDEO=true

LOG_LEVEL=INFO
